# Obtain a Gemini API key and keep the real value only in .env.
API_KEY=your_gemini_api_key

# Use absolute paths. Quote a path if it contains spaces.
PROFILE_PATH=C:\\Users\\your-user\\AppData\\Roaming\\Mozilla\\Firefox\\Profiles\\your-profile
RESUME_PATH=C:\\Users\\your-user\\Documents\\resume.pdf

# Reusable answers for Wellfound application questions.
APPLICATION_PHONE=
APPLICATION_REFERRED=
APPLICATION_REFERRAL_DETAILS=
APPLICATION_VISA_SPONSORSHIP=
APPLICATION_RELOCATION=

# Used by the legacy Gotolink flow; dashboard submissions require clicking its submit button.
AUTO_SUBMIT=false
