# Optional AI providers. Gemini is tried first, then DeepSeek, then the offline template.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Legacy Gemini variable name; GEMINI_API_KEY takes precedence if both are set.
API_KEY=

# Use absolute paths. Quote a path if it contains spaces.
PROFILE_PATH=C:\\Users\\your-user\\AppData\\Roaming\\Mozilla\\Firefox\\Profiles\\your-profile
RESUME_PATH=C:\\Users\\your-user\\Documents\\resume.pdf
# Optional: full path to a local geckodriver executable. Autowell also reuses
# its persistent local cache and downloads a driver only when neither is available.
GECKODRIVER_PATH=

# Reusable answers for Wellfound application questions.
APPLICATION_PHONE=
APPLICATION_EMAIL=
APPLICATION_REFERRED=
APPLICATION_REFERRAL_DETAILS=
APPLICATION_VISA_SPONSORSHIP=
APPLICATION_WORK_AUTHORIZATION=
APPLICATION_RELOCATION=
APPLICATION_LINKEDIN=
APPLICATION_GITHUB=
APPLICATION_EXPERIENCE=
APPLICATION_LOCATION=
APPLICATION_AVAILABILITY=

# JSON map of normalized application questions to saved user-confirmed answers.
APPLICATION_QUESTION_ANSWERS={}

# Used by the legacy Gotolink flow; dashboard submissions require clicking its submit button.
AUTO_SUBMIT=false

# Set true to inspect forms and display proposed saved answers without editing fields or submitting.
AUTOWELL_DRY_RUN=false
